
# calculation functions 
def calculate_kinetic_energy(mass,velocity):
	kinetic_energy = 0.5 * mass * (velocity**2)
	return kinetic_energy

def calculate_potential_energy(mass,g,height):
	potential_energy = mass*g*height
	return potential_energy

def calculate_total_energy(kinetic_energy , potential_energy):
	total_energy = kinetic_energy + potential_energy
	return total_energy

def calculate_momentum(mass,velocity):
	momentum = mass * velocity
	return momentum

# display menu function
def display_menu():
	print("--- Welcome to ⚡ Energy & Momentum Calculator! ---")
	print("Choose a function from below →")
	print("1 - Kinetic Energy")
	print("2 - Potential Energy")
	print("3 - Total Energy")
	print("4 - Momentum")
	print("5 - Exit")

	# type casting the choice to integer
	try:
		choice = int(input("\nEnter your option (1-5): "))
		return choice
	except ValueError as e:
		print(f"Invalid input: {e}")


# main function 
def main():

	# displaying menu
	choice = display_menu()

	if (choice == 1):
		# input
		mass = float(input("Enter mass (kg): "))
		velocity = float(input("Enter velocity (m/s): "))

		# process
		kinetic_energy = calculate_kinetic_energy(mass = mass, velocity = velocity)

		# output
		print(f"Kinetic energy is {kinetic_energy} Joules.")

	if (choice == 2):
		# input
		mass = float(input("Enter mass (kg): "))
		gravitational_constant = 9.81
		height = float(input("Enter height (m): "))

		# process
		potential_energy = calculate_potential_energy(mass = mass, g = gravitational_constant, height = height)

		# output
		print(f"Potential energy is {potential_energy} Joules.")

	if (choice == 3):
		# calculate K.E
		mass = float(input("Enter mass (kg): "))
		velocity = float(input("Enter velocity (m/s): "))
		kinetic_energy = calculate_kinetic_energy(mass = mass, velocity = velocity)

		# calculate P.E
		mass = float(input("Enter mass (kg): "))
		gravitational_constant = 9.81
		height = float(input("Enter height (m): "))
		potential_energy = calculate_potential_energy(mass = mass, g = gravitational_constant, height = height)

		# calculate T.E
		total_energy = calculate_total_energy(kinetic_energy= kinetic_energy, potential_energy=potential_energy)

		# output t.e 
		print(f"Total energy is {total_energy} Joules. ")

	if (choice == 4):
		mass = float(input("Enter mass (kg): "))
		velocity = float(input("Enter velocity (m/s): "))
		momentum = calculate_momentum(mass=mass, velocity=velocity)
		print(f"Momentum is {momentum} kg m/s.")

	if (choice == 5):
		print("Goodbye!")
		return


if __name__ == "__main__":
    main()

